{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Figma parity frozen review plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "frozenAt", "source", "scope", "cells"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": { "const": "figma-parity-plan" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapPath", "mapSha256"],
      "properties": {
        "mapPath": { "type": "string", "minLength": 1 },
        "mapSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "breakpoint"],
      "properties": {
        "route": { "type": "string", "minLength": 1 },
        "breakpoint": { "type": "integer", "minimum": 1 }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["route", "breakpoint", "state", "figmaNodeId", "sectionName"],
        "properties": {
          "route": { "type": "string", "minLength": 1 },
          "breakpoint": { "type": "integer", "minimum": 1 },
          "state": { "type": "string", "minLength": 1 },
          "figmaNodeId": { "type": "string", "minLength": 1 },
          "sectionName": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
