{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "website-qa finding attribution sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "findingIndex", "attributions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": { "const": "website-qa-attribution" },
    "findingIndex": { "type": "string", "minLength": 1 },
    "attributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "cause", "fixLocation", "evidence"],
        "properties": {
          "findingId": { "type": "string", "pattern": "^wqa:" },
          "cause": { "type": "string", "minLength": 1 },
          "fixLocation": { "type": "string", "minLength": 1 },
          "prevention": { "type": "string" },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
