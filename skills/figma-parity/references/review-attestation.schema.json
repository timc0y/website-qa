{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Figma parity review attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "generatedAt", "subject", "actor", "attestations", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": { "const": "figma-parity-attestation" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath", "manifestSha256"],
      "properties": {
        "manifestPath": { "type": "string", "minLength": 1 },
        "manifestSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["human-unverified", "automated"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "attestations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "scope", "verdict", "evidenceIds"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["routes", "breakpoints", "states", "nodeIds"],
            "properties": {
              "routes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "breakpoints": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
              "states": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "nodeIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "verdict": { "enum": ["match", "mismatch", "inconclusive"] },
          "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "note": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
